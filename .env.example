# ============================================================================
# SKULL – UN NUEVO DESPERTAR | Configuración de Firebase
# ============================================================================
# Copia este archivo a `.env.local` y completa las credenciales de tu proyecto
# desde Firebase Console -> Project Settings -> General -> Your apps (Web).

NEXT_PUBLIC_FIREBASE_API_KEY="TU_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="tu-proyecto"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="tu-proyecto.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Lista de correos autorizados para administrar el catálogo (separados por coma).
# Si se deja vacío en desarrollo, cualquier usuario autenticado en Firebase Auth
# tendrá acceso al panel /admin.
NEXT_PUBLIC_ADMIN_EMAILS="admin@skullpiercing.com"

# URL pública del sitio (para generar enlaces de productos en mensajes de WhatsApp)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

